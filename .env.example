PORT=4000
AUTH_SECRET=replace-with-a-long-random-secret
TOKEN_TTL_MS=604800000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=SkillsSwap
MONGODB_DB_NAME=skillsswap
# If MONGODB_URI is set, MongoDB becomes the active backend.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-token
# Optional local fallback when Turso credentials are not set:
# DATABASE_URL=file:///absolute/path/to/skillsswap.db
CORS_ORIGIN=*
